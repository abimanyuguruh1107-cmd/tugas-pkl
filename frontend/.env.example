# Frontend environment variables
# Copy to .env.local for development. Never commit real secrets.

# Backend API base URL.
# Leave empty in development to use the Vite proxy (/api -> http://localhost:3000).
VITE_API_URL=

# LiveKit media server URL (must match backend LIVEKIT_URL).
VITE_LIVEKIT_URL=ws://localhost:7880

# LiveKit public API key. The secret key (LIVEKIT_API_SECRET) must NEVER be
# exposed to the browser — it stays server-side in backend/.env.
VITE_LIVEKIT_PUBLIC_KEY=

# Optional: enables PostHog analytics. Leave empty to disable.
VITE_POSTHOG_KEY=

# Optional: PostHog ingestion host. Leave empty for the US cloud endpoint.
VITE_POSTHOG_HOST=
