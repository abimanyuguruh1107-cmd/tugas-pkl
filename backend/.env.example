# ===== Server Configuration =====
PORT=3000
NODE_ENV=development
APP_NAME=Meetrix

# ===== Database: MongoDB =====
MONGODB_URI=mongodb://localhost:27017/merb-starterpack
MONGO_POOL_SIZE=10
MONGO_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# ===== Cache & Queues: Redis + BullMQ =====
REDIS_URL=redis://localhost:6379

# ===== JWT Authentication =====
# IMPORTANT: In production, use `openssl rand -hex 32` to generate secure secrets
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-prod
# LiveKit media server
# Generate distinct random values locally (for example, with `openssl rand -hex 32`).
# Docker Compose reads these from the root environment; use --env-file backend/.env.
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Short-lived room-token lifetime, in seconds (60-900).
LIVEKIT_TOKEN_TTL_SECONDS=600
LIVEKIT_NODE_IP=127.0.0.1
TURN_HOST=localhost
TURN_EXTERNAL_IP=127.0.0.1
TURN_SHARED_SECRET=

# JWT — use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ===== Email Configuration =====
# Leave SMTP_URL empty to log emails instead of sending them (ideal for dev/CI)
SMTP_URL=
MAIL_FROM=no-reply@example.com
RUN_INLINE_WORKER=false

# ===== Seed Configuration =====
# Automatically seed system roles and admin user on startup
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# ===== Frontend URL =====
# Used in email links (password reset, invitations, etc.)
APP_URL=http://localhost:5173

# ===== Logging =====
LOG_LEVEL=info

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
# Login attempts: max 5 per 15 minutes
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Token refresh: max 10 per minute
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW_MS=60000
# Password reset: max 3 per hour
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000

# ===== Pagination Defaults =====
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# ===== Multi-Tenant Configuration (Phase 1+) =====
MULTI_TENANT_ENABLED=true

# ===== Recording & Transcription (Phase 4+) =====
RECORDING_ENABLED=false
RECORDING_PROVIDER=livekit
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_API_KEY=

# ===== AI Configuration (Phase 5+) =====
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4-turbo

# ===== Object Storage (Phase 5+) =====
STORAGE_ENABLED=false
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=meetrix
STORAGE_REGION=us-east-1

# ===== Retention Policies (Phase 6+) =====
# Number of days to retain records before automatic deletion
RECORDING_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
