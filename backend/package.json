{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/workers/email.worker.ts",
    "seed": "bun src/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" eslint.config.js tsconfig.json",
    "check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" eslint.config.js tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "bullmq": "^5.63.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.3",
    "mongoose": "^9.9.5",
    "nodemailer": "^10.1.4",
    "zod": "^4.6.6"
