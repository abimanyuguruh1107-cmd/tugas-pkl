{
  // Infrastructure-as-code project (Pulumi).
  // Kept separate from the backend and frontend TypeScript projects because
  // it targets a different runtime and dependency set.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["pulumi/**/*.ts"]
}
